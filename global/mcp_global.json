{
  "$schema": "https://json.schemastore.org/claude-mcp-config",
  "_comment": "GLOBAL MCP CONFIG — Copy to ~/.claude.json",
  "_install": [
    "1. arxiv:      uv tool install arxiv-mcp-server",
    "2. context7:   npx auto-fetches (no install)",
    "3. wandb:      uvx auto-fetches (no install, needs WANDB_API_KEY)",
    "4. Set env:    export WANDB_API_KEY='your-key' in ~/.bashrc or ~/.zshrc"
  ],
  "mcpServers": {
    "arxiv": {
      "_usage": "@paper-fetcher → search arXiv preprints",
      "_install": "uv tool install arxiv-mcp-server",
      "type": "stdio",
      "command": "arxiv-mcp-server"
    },
    "context7": {
      "_usage": "All agents → library documentation (PyTorch, HuggingFace, PyG, RDKit, etc.)",
      "_install": "npx auto-fetches",
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "wandb": {
      "_usage": "@experiment-fetcher → query experiment metrics and runs",
      "_install": "uvx auto-fetches, needs WANDB_API_KEY env var",
      "type": "stdio",
      "command": "uvx",
      "args": ["wandb-mcp-server"],
      "env": {
        "WANDB_API_KEY": "${WANDB_API_KEY}"
      }
    }
  }
}
